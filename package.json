{
  "name": "pi-annotate-anything",
  "version": "1.4.0",
  "description": "Pi extension: annotate arbitrary line/character ranges of any local file, injected as a quote block plus comment",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "annotation",
    "vim"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang-stephen/pi-annotate-anything.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
